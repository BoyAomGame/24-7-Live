# Copy this file to .env if you want to restore the defaults.
VIDEO_SIZE=1280x720
FRAME_RATE=30
GOP_SECONDS=2
VIDEO_BITRATE=4500k
VIDEO_MAXRATE=4500k
VIDEO_BUFSIZE=9000k
X264_PRESET=veryfast
AUDIO_BITRATE=160k
AUDIO_RATE=48000
AUDIO_CHANNELS=2
LIVE_CONFIRMATIONS=2
CHECK_INTERVAL_SECONDS=2

# Optional YouTube Live relay. Keep the stream key only in .env, never Git.
# Copy the exact server URL and stream key from YouTube Studio > Go Live.
YOUTUBE_RTMP_URL=rtmps://a.rtmps.youtube.com/live2
YOUTUBE_STREAM_KEY=
YOUTUBE_RECONNECT_SECONDS=5
